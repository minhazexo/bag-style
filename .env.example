# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# These are public storefront settings and can also be changed in /admin.
# Never put a service_role / secret key in a VITE_ variable.

# Public site URL used by `bun run build` for sitemap.xml, robots.txt,
# canonical links and product JSON-LD. No trailing slash.
SITE_URL=https://example.com

# Optional: PostHog project key for storefront funnel analytics.
# Without a key no analytics code is loaded. Use the public project API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
